<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FreeScreenRecorder.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FreeScreenRecorder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,36">
        <Grid
            MaxWidth="1180"
            HorizontalAlignment="Center"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="16">
                <StackPanel Spacing="4" Margin="0,0,0,6">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="FreeScreen Recorder" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Monitor recording with microphone, system audio, cursor highlight and click effects."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE7F4;" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Capture" />
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Screen" />
                            <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="MonitorComboBox"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Select a display" />
                                <Button
                                    x:Name="RefreshMonitorsButton"
                                    Grid.Column="1"
                                    Click="RefreshMonitorsButton_Click"
                                    ToolTipService.ToolTip="Refresh displays">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Video codec" />
                            <ComboBox
                                x:Name="CodecComboBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="CodecComboBox_SelectionChanged" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Encoder" />
                            <ComboBox
                                x:Name="EncoderComboBox"
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Quality" />
                            <ComboBox
                                x:Name="QualityComboBox"
                                Grid.Row="3"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Frame rate" />
                            <ComboBox
                                x:Name="FpsComboBox"
                                Grid.Row="4"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch" />
                        </Grid>

                        <TextBlock
                            x:Name="EncoderHintText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Auto picks the best hardware encoder available, then falls back to CPU."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE767;" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Audio" />
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Microphone" />

                            <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    x:Name="MicrophoneToggle"
                                    Grid.Column="0"
                                    MinWidth="0"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="MicrophoneToggle_Toggled" />
                                <ComboBox
                                    x:Name="MicrophoneComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Select a microphone" />
                                <Button
                                    x:Name="RefreshMicrophonesButton"
                                    Grid.Column="2"
                                    Click="RefreshMicrophonesButton_Click"
                                    ToolTipService.ToolTip="Refresh microphones">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                </Button>
                            </Grid>

                            <ToggleSwitch
                                x:Name="SystemAudioToggle"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Header="System audio (loopback)"
                                OffContent="Off"
                                OnContent="On" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="System audio comes from the current default playback device. Microphone and system audio are mixed into one AAC track."
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE8B7;" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Output" />
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Folder" />
                            <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="OutputFolderBox"
                                    Grid.Column="0"
                                    TextChanged="OutputFolderBox_TextChanged" />
                                <Button
                                    Grid.Column="1"
                                    Click="BrowseFolderButton_Click"
                                    Content="Browse" />
                            </Grid>

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="ffmpeg" />
                            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="FfmpegBox"
                                    Grid.Column="0"
                                    TextChanged="FfmpegBox_TextChanged" />
                                <Button
                                    Grid.Column="1"
                                    Click="BrowseFfmpegButton_Click"
                                    Content="Browse" />
                            </Grid>

                            <TextBlock
                                x:Name="FfmpegStatusText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Looking for ffmpeg.exe..."
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="16">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE7C8;" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Recorder" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing
                                x:Name="RecordingRing"
                                Width="22"
                                Height="22"
                                IsActive="False" />
                            <TextBlock
                                x:Name="StatusText"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Ready to record" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TimerText"
                            FontFamily="Consolas"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Text="00:00:00" />

                        <Button
                            x:Name="RecordButton"
                            Height="60"
                            HorizontalAlignment="Stretch"
                            Background="#E5484D"
                            Click="RecordButton_Click"
                            CornerRadius="10"
                            Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="22" Glyph="&#xE7C8;" />
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="Start recording" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="StopButton"
                            Height="46"
                            HorizontalAlignment="Stretch"
                            Click="StopButton_Click"
                            Content="Stop and save"
                            CornerRadius="10"
                            IsEnabled="False" />

                        <TextBlock
                            x:Name="OutputFilePreviewText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Output: -"
                            TextWrapping="Wrap" />

                        <HyperlinkButton
                            x:Name="OpenOutputButton"
                            Click="OpenOutputButton_Click"
                            Content="Open output folder"
                            IsEnabled="False" />

                        <InfoBar
                            x:Name="ErrorInfoBar"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Error"
                            Title="Recording error" />
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE790;" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Cursor effects" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="CursorHighlightToggle"
                            Header="Cursor highlight"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="CursorHighlightToggle_Toggled" />

                        <Button
                            x:Name="CursorColorButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    x:Name="CursorColorSwatch"
                                    Width="18"
                                    Height="18"
                                    Background="#FF22D3EE"
                                    CornerRadius="4" />
                                <TextBlock Text="Cursor colour" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker
                                        x:Name="CursorColorPicker"
                                        ColorChanged="CursorColorPicker_ColorChanged"
                                        IsAlphaEnabled="False"
                                        IsColorChannelTextInputVisible="False"
                                        IsHexInputVisible="True" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Highlight size" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="CursorSizeSlider"
                                    Grid.Column="0"
                                    Maximum="320"
                                    Minimum="48"
                                    StepFrequency="4"
                                    Value="96"
                                    ValueChanged="CursorSizeSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="CursorSizeText"
                                    Grid.Column="1"
                                    MinWidth="52"
                                    VerticalAlignment="Center"
                                    Text="96 px" />
                            </Grid>
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="ClickEffectsToggle"
                            Header="Click rings"
                            OffContent="Off"
                            OnContent="On" />

                        <Button
                            x:Name="ClickColorButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    x:Name="ClickColorSwatch"
                                    Width="18"
                                    Height="18"
                                    Background="#FFFF5252"
                                    CornerRadius="4" />
                                <TextBlock Text="Click colour" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker
                                        x:Name="ClickColorPicker"
                                        ColorChanged="ClickColorPicker_ColorChanged"
                                        IsAlphaEnabled="False"
                                        IsColorChannelTextInputVisible="False"
                                        IsHexInputVisible="True" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="The highlight and click rings are click-through, so menus and dialogs keep working and are captured in the video."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Good to know" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="&#x2022; Records the selected monitor at its native resolution.&#x0a;&#x2022; Context menus, tooltips and dialogs are captured.&#x0a;&#x2022; MP4 output is fast-start enabled for quick sharing.&#x0a;&#x2022; Press Stop to finalize the file; do not close the app while recording."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
